[build-system]
requires = ["setuptools>=68", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "{{ project_name }}"
version = "0.1.0"
requires-python = ">=3.10"

dependencies = [
    "bedrock-agentcore >= 1.0.3",
    "strands-agents>=0.1.8",
    "strands-agents-tools>=0.2.0",
    "nest-asyncio>=1.5.0",
    "playwright>=1.40.0",
    "fastapi >= 0.115.0",
]
